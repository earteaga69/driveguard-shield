<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>DriveGuard Shield | Bloqueo de distracciones al volante</title>
<meta name="description" content="Software telemático que bloquea llamadas y notificaciones automáticamente mientras conduces. Para uso individual y para flotas comerciales." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #10151A; --surface: #FFFFFF; --paper: #F2F6F7;
    --brand: #1F6F78; --brand-deep: #154F56; --brand-pale: #E4F0F1;
    --accent: #F2A63D; --accent-deep: #D68A22;
    --danger: #E2574C;
    --text: #1A2327; --muted: #5C6B72; --line: #DCE6E8;
    --display: 'Space Grotesk', system-ui, sans-serif;
    --body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --mono: 'IBM Plex Mono', 'Consolas', monospace;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: var(--body); color: var(--text); background: var(--paper); line-height: 1.6; }
  a { color: inherit; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  section { padding: 80px 0; }
  h1, h2, h3 { font-family: var(--display); letter-spacing: -0.01em; }
  .eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand); margin-bottom: 12px; }
  .btn { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; padding: 12px 22px; border-radius: 6px; text-decoration: none; border: 1px solid transparent; cursor: pointer; }
  .btn-accent { background: var(--accent); color: #2A1600; }
  .btn-accent:hover { background: var(--accent-deep); }
  .btn-outline { background: transparent; color: #fff; border-color: rgba(255,255,255,0.35); }
  .btn-outline:hover { border-color: #fff; }
  .btn-brand { background: var(--brand); color: #fff; }
  .btn-brand:hover { background: var(--brand-deep); }

  header { position: sticky; top: 0; z-index: 50; background: rgba(16,21,26,0.96); backdrop-filter: blur(6px); }
  header .wrap { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; }
  .logo { display: flex; align-items: center; gap: 8px; font-family: var(--display); font-weight: 700; font-size: 17px; color: #fff; }
  .logo .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
  nav { display: flex; align-items: center; gap: 24px; }
  nav a.navlink { color: rgba(255,255,255,0.7); font-size: 14px; text-decoration: none; }
  nav a.navlink:hover { color: #fff; }

  .status-badge { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.05em; background: rgba(242,166,61,0.12); color: var(--accent); border: 1px solid rgba(242,166,61,0.4); padding: 5px 12px; border-radius: 999px; margin-bottom: 20px; }
  .status-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  .hero { background: linear-gradient(180deg, var(--ink) 0%, #0A0D10 100%); color: #fff; padding: 64px 0 90px; }
  .hero .wrap { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; }
  .hero h1 { font-size: 38px; font-weight: 700; line-height: 1.15; margin-bottom: 18px; }
  .hero p.lead { font-size: 16px; color: rgba(255,255,255,0.72); max-width: 46ch; margin-bottom: 30px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* phone mockup */
  .phone { width: 260px; margin: 0 auto; background: #05070A; border-radius: 36px; padding: 14px; border: 1px solid rgba(255,255,255,0.12); box-shadow: 0 30px 60px rgba(0,0,0,0.4); }
  .phone-screen { background: linear-gradient(180deg, #0E1C1F 0%, #0A1214 100%); border-radius: 24px; padding: 22px 16px; min-height: 460px; position: relative; overflow: hidden; }
  .phone-time { font-family: var(--mono); font-size: 12px; color: rgba(255,255,255,0.6); text-align: center; margin-bottom: 18px; }
  .speed-ring { width: 130px; height: 130px; border-radius: 50%; border: 3px solid var(--brand); margin: 0 auto 14px; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 0 30px rgba(31,111,120,0.5); }
  .speed-num { font-family: var(--mono); font-size: 34px; font-weight: 600; color: #fff; line-height: 1; }
  .speed-unit { font-family: var(--mono); font-size: 10px; color: rgba(255,255,255,0.5); letter-spacing: 0.08em; margin-top: 2px; }
  .mode-pill { display: flex; align-items: center; justify-content: center; gap: 6px; font-family: var(--mono); font-size: 11px; color: var(--brand); background: rgba(31,111,120,0.15); border: 1px solid rgba(31,111,120,0.4); border-radius: 999px; padding: 6px 12px; margin: 0 auto 20px; width: fit-content; }
  .mode-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand); }
  .phone-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; }
  .phone-card.blocked { border-color: rgba(226,87,76,0.4); background: rgba(226,87,76,0.08); }
  .phone-card .label { font-family: var(--mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(255,255,255,0.45); margin-bottom: 4px; }
  .phone-card .blocked .label { color: var(--danger); }
  .phone-card .title { font-size: 12.5px; color: #fff; font-weight: 500; }
  .phone-card .sub { font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 2px; }

  .trustline { background: #fff; border-bottom: 1px solid var(--line); padding: 18px 0; text-align: center; font-size: 13px; color: var(--muted); }

  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px; margin-top: 36px; }
  .feature-card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 24px; }
  .feature-tag { font-family: var(--mono); font-size: 10px; color: var(--brand); border: 1px solid var(--brand); display: inline-block; padding: 2px 8px; border-radius: 3px; margin-bottom: 12px; letter-spacing: 0.04em; }
  .feature-card h3 { font-size: 16px; margin-bottom: 8px; }
  .feature-card p { font-size: 13.5px; color: var(--muted); }

  .plans-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; margin-top: 36px; }
  .plan-card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 32px; display: flex; flex-direction: column; }
  .plan-card.featured { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
  .plan-name { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--brand); margin-bottom: 10px; }
  .plan-price { font-family: var(--display); font-size: 34px; font-weight: 700; margin-bottom: 4px; }
  .plan-price span { font-size: 14px; font-weight: 400; color: var(--muted); }
  .plan-note { font-size: 12px; color: var(--muted); margin-bottom: 20px; }
  .plan-features { list-style: none; margin-bottom: 24px; flex: 1; }
  .plan-features li { font-size: 13.5px; padding: 7px 0; border-bottom: 1px solid var(--line); display: flex; gap: 8px; }
  .plan-features li:last-child { border-bottom: none; }
  .plan-features li::before { content: "✓"; color: var(--brand); font-weight: 700; }

  .fleet-section { background: var(--ink); color: #fff; }
  .fleet-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; margin-top: 36px; align-items: start; }
  .fleet-grid p { color: rgba(255,255,255,0.7); font-size: 14.5px; margin-bottom: 16px; }
  .fleet-features { list-style: none; margin-top: 20px; }
  .fleet-features li { font-size: 13.5px; padding: 6px 0; color: rgba(255,255,255,0.75); display: flex; gap: 8px; }
  .fleet-features li::before { content: "→"; color: var(--accent); }
  .ticket { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; padding: 28px; }
  .ticket-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.5); display: block; margin-bottom: 6px; margin-top: 16px; }
  .ticket-label:first-child { margin-top: 0; }
  .ticket input, .ticket textarea { width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 10px 12px; border-radius: 6px; font-size: 14px; font-family: var(--body); }
  .ticket textarea { resize: vertical; min-height: 70px; }
  .ticket button { margin-top: 20px; width: 100%; justify-content: center; font-size: 14.5px; padding: 13px; }

  footer { background: #0A0D10; color: rgba(255,255,255,0.5); padding: 26px 0; font-size: 12.5px; }
  footer .wrap { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  footer a { text-decoration: underline; }

  @media (max-width: 860px) {
    .hero .wrap, .fleet-grid { grid-template-columns: 1fr; }
    .hero h1 { font-size: 28px; }
    nav .navlink { display: none; }
    section { padding: 56px 0; }
  }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <div class="logo"><span class="dot"></span>DriveGuard Shield</div>
    <nav>
      <a class="navlink" href="#como-funciona">Cómo funciona</a>
      <a class="navlink" href="#planes">Planes</a>
      <a class="navlink" href="#flotas">Flotas</a>
      <a class="btn btn-brand" href="https://wa.me/525544950906" target="_blank" rel="noopener">WhatsApp</a>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="wrap">
    <div>
      <div class="status-badge"><span class="dot"></span>EN DESARROLLO · REGISTRO EN TRÁMITE ANTE INDAUTOR</div>
      <h1>Tu celular deja de distraerte en cuanto arrancas el auto.</h1>
      <p class="lead">Software telemático que bloquea llamadas y silencia notificaciones automáticamente al detectar que el vehículo está en movimiento — y responde por ti mientras conduces seguro.</p>
      <div class="ctas">
        <a class="btn btn-accent" href="#planes">Ver planes individuales</a>
        <a class="btn btn-outline" href="#flotas">Cotizar para mi flota</a>
      </div>
    </div>

    <div class="phone">
      <div class="phone-screen">
        <div class="phone-time">14:32 · Lunes</div>
        <div class="speed-ring">
          <div class="speed-num">62</div>
          <div class="speed-unit">KM/H</div>
        </div>
        <div class="mode-pill"><span class="dot"></span>MODO CONDUCCIÓN ACTIVO</div>

        <div class="phone-card blocked">
          <div class="label">Llamada bloqueada</div>
          <div class="title">Mamá</div>
          <div class="sub">Se enviará SMS automático</div>
        </div>
        <div class="phone-card">
          <div class="label">SMS auto-respuesta enviado</div>
          <div class="title">"Voy manejando, te contesto en un momento 🚗"</div>
        </div>
        <div class="phone-card">
          <div class="label">Notificaciones silenciadas</div>
          <div class="title">WhatsApp · Instagram · TikTok</div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="trustline">Contactos VIP y llamadas repetidas en menos de 3 minutos siempre pasan — pensado para emergencias reales.</div>

<section id="como-funciona">
  <div class="wrap">
    <div class="eyebrow">Qué hace por ti</div>
    <h2>Cómo funciona</h2>
    <div class="features-grid">
      <div class="feature-card">
        <span class="feature-tag">GPS</span>
        <h3>Detección de velocidad en tiempo real</h3>
        <p>Combina GPS y sensores del teléfono para saber cuándo el vehículo está en movimiento.</p>
      </div>
      <div class="feature-card">
        <span class="feature-tag">LLAMADAS</span>
        <h3>Inhibición automática de llamadas</h3>
        <p>Al superar el umbral de velocidad, las llamadas entrantes se bloquean sin que tengas que hacer nada.</p>
      </div>
      <div class="feature-card">
        <span class="feature-tag">NOTIFICACIONES</span>
        <h3>Silencio de apps distractoras</h3>
        <p>WhatsApp, Facebook, TikTok, Instagram, Telegram — las notificaciones emergentes se silencian mientras conduces.</p>
      </div>
      <div class="feature-card">
        <span class="feature-tag">SMS</span>
        <h3>Respuesta automática</h3>
        <p>Quien te llama o escribe recibe un mensaje avisando que estás manejando de forma segura.</p>
      </div>
      <div class="feature-card">
        <span class="feature-tag">EMERGENCIA</span>
        <h3>Protocolo de contactos VIP</h3>
        <p>Llamadas repetidas en menos de 3 minutos y contactos marcados como prioritarios siempre pasan.</p>
      </div>
      <div class="feature-card">
        <span class="feature-tag">FLOTAS</span>
        <h3>Métricas y puntuación de conducción</h3>
        <p>Para transporte comercial y aseguradoras: telemetría y calificación de manejo por conductor.</p>
      </div>
    </div>
  </div>
</section>

<section id="planes" style="background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
  <div class="wrap">
    <div class="eyebrow">Uso individual (P2C)</div>
    <h2>Planes para tu celular</h2>
    <p style="color:var(--muted); max-width:60ch; margin-top:10px;">Producto en desarrollo — puedes apartar tu plan ahora y te avisamos en cuanto esté disponible para descargar.</p>
    <div class="plans-grid">
      <div class="plan-card">
        <div class="plan-name">Básico</div>
        <div class="plan-price">$150 <span>MXN / mes</span></div>
        <div class="plan-note">Lo esencial para dejar de distraerte al volante.</div>
        <ul class="plan-features">
          <li>Bloqueo automático de llamadas</li>
          <li>Silencio de notificaciones de apps</li>
          <li>Respuesta automática por SMS</li>
          <li>Protocolo de emergencia (VIP + llamadas repetidas)</li>
        </ul>
        <a class="btn btn-brand" href="https://wa.me/525544950906?text=Quiero%20apartar%20el%20plan%20B%C3%A1sico%20de%20DriveGuard%20Shield" target="_blank" rel="noopener">Apartar plan Básico</a>
      </div>
      <div class="plan-card featured">
        <div class="plan-name">Premium</div>
        <div class="plan-price">$300 <span>MXN / mes</span></div>
        <div class="plan-note">Todo lo del plan Básico, más métricas personales.</div>
        <ul class="plan-features">
          <li>Todo lo del plan Básico</li>
          <li>Métricas y puntuación de tu propia conducción</li>
          <li>Contactos VIP ilimitados</li>
          <li>Soporte prioritario</li>
        </ul>
        <a class="btn btn-accent" href="https://wa.me/525544950906?text=Quiero%20apartar%20el%20plan%20Premium%20de%20DriveGuard%20Shield" target="_blank" rel="noopener">Apartar plan Premium</a>
      </div>
    </div>
  </div>
</section>

<section class="fleet-section" id="flotas">
  <div class="wrap">
    <div class="eyebrow" style="color:#9CC9CE;">Uso comercial (P2P)</div>
    <h2>Para flotas y aseguradoras</h2>
    <div class="fleet-grid">
      <div>
        <p>Si tienes una flota de vehículos comerciales o una aseguradora interesada en reducir siniestros por distracción al volante, el precio se cotiza según el número de vehículos.</p>
        <ul class="fleet-features">
          <li>App de administración para toda la flota</li>
          <li>Métricas y puntuación de conducción por conductor</li>
          <li>Reportes agregados para aseguradoras</li>
          <li>Precio escalonado según número de vehículos</li>
        </ul>
      </div>
      <form class="ticket" id="fleetForm">
        <label class="ticket-label" for="f-empresa">Empresa</label>
        <input id="f-empresa" type="text" required placeholder="Nombre de tu empresa" />

        <label class="ticket-label" for="f-vehiculos">Número de vehículos</label>
        <input id="f-vehiculos" type="number" min="1" required placeholder="Ej. 25" />

        <label class="ticket-label" for="f-contacto">Tu nombre</label>
        <input id="f-contacto" type="text" required placeholder="Nombre de contacto" />

        <label class="ticket-label" for="f-mensaje">Mensaje (opcional)</label>
        <textarea id="f-mensaje" placeholder="Cuéntanos brevemente qué necesitas"></textarea>

        <button type="submit" class="btn btn-accent">Solicitar cotización por WhatsApp</button>
      </form>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <span>© <span id="year"></span> DriveGuard Shield — en desarrollo, registro en trámite ante INDAUTOR.</span>
    <span>
      Parte del mismo ecosistema:
      <a href="https://core-prompt-studio-m1.vercel.app" target="_blank" rel="noopener">CORE</a> ·
      <a href="https://brujula-ia-omega.vercel.app" target="_blank" rel="noopener">Brújula IA</a> ·
      <a href="https://soluciones-ti-cuautitlan.vercel.app" target="_blank" rel="noopener">Soluciones TI Cuautitlán</a>
    </span>
  </div>
</footer>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();
  document.getElementById('fleetForm').addEventListener('submit', function (e) {
    e.preventDefault();
    const empresa = document.getElementById('f-empresa').value.trim();
    const vehiculos = document.getElementById('f-vehiculos').value.trim();
    const contacto = document.getElementById('f-contacto').value.trim();
    const mensaje = document.getElementById('f-mensaje').value.trim();
    const texto = `Hola, soy ${contacto} de ${empresa}. Quiero cotizar DriveGuard Shield para una flota de ${vehiculos} vehículos.${mensaje ? " " + mensaje : ""}`;
    window.open(`https://wa.me/525544950906?text=${encodeURIComponent(texto)}`, '_blank');
  });
</script>

</body>
</html>
